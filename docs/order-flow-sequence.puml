@startuml OrderFlowSequence
title Order creation scenario

skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceArrowThickness 1
skinparam ParticipantBorderColor #475569
skinparam ParticipantBackgroundColor #f8fafc
skinparam DatabaseBackgroundColor #fdecc8
skinparam DatabaseBorderColor #b7791f

actor "Покупатель" as Customer
participant "WEB-интерфейс" as Web
participant "Backend API" as Api
participant "Модуль корзины" as Cart
participant "Модуль заказов" as Ordering
participant "Модуль склада" as Inventory
database "PostgreSQL" as Db

Customer -> Web : оформляет заказ
Web -> Api : данные корзины,\nдоставки и оплаты
Api -> Cart : оформить корзину

Cart -> Db : получить корзину
Cart -> Cart : проверить состав\nи данные оформления
Cart -> Ordering : передать данные заказа

Ordering -> Ordering : создать заказ
Ordering -> Inventory : запросить резерв товара

Inventory -> Db : проверить остатки

alt товар есть на складе
  Inventory -> Db : зарезервировать товар
  Inventory --> Ordering : резерв подтвержден
  Ordering -> Db : сохранить заказ
  Ordering --> Api : заказ создан
  Api --> Web : 200 OK
else товара недостаточно
  Inventory --> Ordering : резерв отклонен
  Ordering -> Db : сохранить отказ
  Ordering --> Api : заказ не создан
  Api --> Web : ошибка оформления
end

@enduml
